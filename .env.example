# Set these to the serial ports reported on your machine.
LEADER_PORT=/dev/tty.usbmodem5B420768791
FOLLOWER_PORT=/dev/tty.usbmodem5B420769801

# Camera indexes can differ between machines; camera names, resolution and FPS
# are fixed in the scripts.
WRIST_CAMERA_INDEX=1
TOP_CAMERA_INDEX=0

# Hugging Face Hub namespace. Authenticate separately with `hf auth login`,
# or set HF_TOKEN here if you prefer environment based authentication.
HF_USERNAME=your-huggingface-username
# HF_TOKEN=
